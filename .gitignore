.env
.env.local
.env.*.local

__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Agent 运行产物
memory/sessions/*.json
memory/runs/*/
!memory/runs/.gitkeep
memory/audit/*.jsonl
!memory/audit/.gitkeep

# v5：本地论文 RAG 索引（运行时生成，体积大）
memory/rag/index.faiss
memory/rag/index.faiss.ids.json
memory/rag/chunks.jsonl
memory/rag/bm25.json
memory/rag/manifest.json
!memory/rag/.gitkeep

# 测试用真实 PDF（单篇不进 git，压缩 zip 进 git 让 CI 拿到）
tests/fixtures/pdfs/*.pdf
!tests/fixtures/pdfs/.gitkeep
# 压缩 zip 用于 CI workflow 下载（25MB 一次性 commit）
!tests/fixtures/pdfs/pdfs.zip

